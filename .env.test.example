# Copy this file to .env.test and fill in your values
# .env.test is gitignored

# Supabase credentials (same as .env — needed for the dev server)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Test user — must be a confirmed Supabase Auth user with a business already created
TEST_USER_EMAIL=your-test-user@example.com
TEST_USER_PASSWORD=your-password

# Business slug — the slug of the business owned by TEST_USER_EMAIL
# Used by booking + availability tests
TEST_BUSINESS_SLUG=your-business-slug
